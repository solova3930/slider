<Window x:Class="slider.SliderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Слайдер"
        Icon="/app.ico"
        Height="720"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        KeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        Loaded="SliderWindow_Loaded"
        Focusable="True">

    <Grid Background="Black">

        <!-- Слой A -->
        <Grid x:Name="LayerA"
              Opacity="0">

            <Image x:Name="SlideImageA"
                   Stretch="Uniform"
                   Visibility="Collapsed"/>

            <MediaElement x:Name="SlideVideoA"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="Uniform"
                          Visibility="Collapsed"
                          MediaEnded="SlideVideo_MediaEnded"/>
        </Grid>

        <!-- Слой B -->
        <Grid x:Name="LayerB"
              Opacity="0">

            <Image x:Name="SlideImageB"
                   Stretch="Uniform"
                   Visibility="Collapsed"/>

            <MediaElement x:Name="SlideVideoB"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="Uniform"
                          Visibility="Collapsed"
                          MediaEnded="SlideVideo_MediaEnded"/>
        </Grid>

    </Grid>
</Window>