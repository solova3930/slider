<Window x:Class="slider.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:slider"
        xmlns:models="clr-namespace:slider.Models"
        mc:Ignorable="d"
        Icon="/app.ico"
        Title="Конфигуратор"
        Height="850"
        Width="1400"
        MinHeight="760"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1e1a1a"
        AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragEnter"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop">

    <Window.Resources>
        <SolidColorBrush x:Key="BtnPrimaryBrush" Color="#5A5A5A"/>
        <SolidColorBrush x:Key="BtnPrimaryHoverBrush" Color="#6A6A6A"/>
        <SolidColorBrush x:Key="BtnPrimaryPressedBrush" Color="#4A4A4A"/>

        <SolidColorBrush x:Key="BtnSecondaryBrush" Color="#3F4652"/>
        <SolidColorBrush x:Key="BtnSecondaryHoverBrush" Color="#4B5563"/>
        <SolidColorBrush x:Key="BtnSecondaryPressedBrush" Color="#374151"/>

        <SolidColorBrush x:Key="BtnDangerBrush" Color="#8B0000"/>
        <SolidColorBrush x:Key="BtnDangerHoverBrush" Color="#A00000"/>
        <SolidColorBrush x:Key="BtnDangerPressedBrush" Color="#700000"/>

        <SolidColorBrush x:Key="WindowBrush" Color="#3c3c3c"/>
        <SolidColorBrush x:Key="CardBrush" Color="#3c3c3c"/>
        <SolidColorBrush x:Key="CardBrushAlt" Color="#2c2c2c"/>
        <SolidColorBrush x:Key="BorderBrushDark" Color="#3c3c3c"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4c4c4c"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#5c5c5c"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#374151"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFCECECE"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6c6c6c"/>
        <SolidColorBrush x:Key="InputBrush" Color="#1c1c1c"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#22C55E"/>

        <Style x:Key="WeekDayToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#1C1C1C"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="9">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#533232"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root"
                                Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#6A3A3A"/>
                                    </Setter.Value>
                                </Setter>

                                <Setter Property="Foreground"
                                Value="#FFFFFF"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>

                                <Setter TargetName="Root"
                                Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#7A4545"/>
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#452929"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteRowButtonStyle" TargetType="Button">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkEffectComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="BorderBrush" Value="#5A5A5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                                    <Border Grid.Column="1"
                                    Background="#3A3A3A"
                                    BorderBrush="#5A5A5A"
                                    BorderThickness="1,0,0,0">
                                        <TextBlock Text="▼"
                                           Foreground="#EAEAEA"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                Background="#2B2B2B"
                                BorderBrush="#5A5A5A"
                                BorderThickness="1">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#777777"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#777777"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#404040"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#5A5A5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddPeriodButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#5A5A5A"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect x:Name="ShadowEffect"
                                          BlurRadius="0"
                                          ShadowDepth="0"
                                          Opacity="0"
                                          Color="#000000"/>
                            </Border.Effect>

                            <ContentPresenter x:Name="ContentHost"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#6A6A6A"
                                                    Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ContentHost"
                                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                     To="1.12"
                                                     Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ContentHost"
                                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                     To="1.12"
                                                     Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.35"
                                                     Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                                     Storyboard.TargetProperty="BlurRadius"
                                                     To="12"
                                                     Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#5A5A5A"
                                                    Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ContentHost"
                                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                     To="1"
                                                     Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ContentHost"
                                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                     To="1"
                                                     Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                                     Storyboard.TargetProperty="BlurRadius"
                                                     To="0"
                                                     Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4A4A4A"/>
                                <Setter TargetName="ContentHost" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplyPeriodButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#1c1c1c"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#533232"
                                                    Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#1c1c1c"        
                                                    Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#4D5668"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplyButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#4C4C4C"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="12"
                        SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect x:Name="ShadowEffect"
                                          BlurRadius="0"
                                          ShadowDepth="0"
                                          Opacity="0"
                                          Color="#000000"/>
                            </Border.Effect>

                            <ContentPresenter x:Name="ContentHost"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#5C5C5C"
                                                    Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ContentHost"
                                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                     To="1.06"
                                                     Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ContentHost"
                                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                     To="1.06"
                                                     Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0.30"
                                                     Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                                     Storyboard.TargetProperty="BlurRadius"
                                                     To="10"
                                                     Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#4C4C4C"
                                                    Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ContentHost"
                                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                     To="1"
                                                     Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ContentHost"
                                                     Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                     To="1"
                                                     Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="ShadowEffect"
                                                     Storyboard.TargetProperty="BlurRadius"
                                                     To="0"
                                                     Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3F3F3F"/>
                                <Setter TargetName="ContentHost" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource BtnPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#6A6A6A"
                                                Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.02"
                                                 Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.02"
                                                 Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#5A5A5A"
                                                Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1"
                                                 Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BtnPrimaryPressedBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PeriodMenuDotsStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallTimeTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#EAEAEA"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TimeBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                  VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TimeBorder"
                                Property="Background"
                                Value="#242424"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TimeBorder"
                                Property="Background"
                                Value="#292929"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkDatePickerStyle" TargetType="DatePicker">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="DatePicker">

                        <Border x:Name="DateBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>


                                <!-- Дата -->

                                <DatePickerTextBox x:Name="PART_TextBox"
                                           Grid.Column="0"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           Foreground="#F0F0F0"
                                           FontSize="14"
                                           Padding="12,0"
                                           VerticalContentAlignment="Center"
                                           FocusVisualStyle="{x:Null}"/>


                                <!-- Кнопка календаря -->

                                <Button x:Name="PART_Button"
                                Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                Cursor="Hand">

                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">

                                            <Border x:Name="CalendarButtonBackground"
                                            Background="Transparent"
                                            CornerRadius="0,8,8,0">

                                                <Grid Width="42"
                                              Height="42">

                                                    <!-- Иконка календаря -->

                                                    <Grid Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">

                                                        <Border BorderBrush="#BDBDBD"
                                                        BorderThickness="1.4"
                                                        CornerRadius="2"
                                                        Margin="0,2,0,0"/>

                                                        <Border Height="4"
                                                        BorderBrush="#BDBDBD"
                                                        BorderThickness="0,0,0,1.4"
                                                        VerticalAlignment="Top"
                                                        Margin="1,5,1,0"/>

                                                        <Rectangle Width="1.5"
                                                           Height="4"
                                                           Fill="#BDBDBD"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Top"
                                                           Margin="4,0,0,0"/>

                                                        <Rectangle Width="1.5"
                                                           Height="4"
                                                           Fill="#BDBDBD"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top"
                                                           Margin="0,0,4,0"/>

                                                    </Grid>

                                                </Grid>

                                            </Border>

                                            <ControlTemplate.Triggers>

                                                <Trigger Property="IsMouseOver"
                                                 Value="True">

                                                    <Setter TargetName="CalendarButtonBackground"
                                                    Property="Background"
                                                    Value="#303030"/>

                                                </Trigger>

                                            </ControlTemplate.Triggers>

                                        </ControlTemplate>
                                    </Button.Template>

                                </Button>


                                <!-- Popup календаря -->

                                <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False">

                                    <Border Background="#1C1C1C"
                                    CornerRadius="8"
                                    Padding="4">

                                        <Calendar x:Name="PART_Calendar"
                                          Background="#1C1C1C"
                                          Foreground="#EAEAEA"
                                          BorderThickness="0"/>

                                    </Border>

                                </Popup>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="DateBorder"
                                Property="Background"
                                Value="#242424"/>

                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin"
                             Value="True">

                                <Setter TargetName="DateBorder"
                                Property="Background"
                                Value="#292929"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                        <Border Background="Transparent"
                        BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="PlaylistRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#404040"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#5A5A5A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>

                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#5A5A5A"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="SpinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#FF1c1c1c"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#ff533232"
                                                    Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Root"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#FF1c1c1c"
                                                    Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FF1c1c1c"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BtnDangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#A00000"
                                                Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.02"
                                                 Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.02"
                                                 Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#8B0000"
                                                Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1"
                                                 Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BtnDangerPressedBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="DotsButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>

            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- ToggleButton рисует само "поле" и стрелочку -->
                            <ToggleButton 
                        Background="#FF1C1C1C"
                        BorderBrush="#FF1C1C1C"
                        Foreground="#FFA0C0CE"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                        ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    CornerRadius="2">
                                                        <Grid HorizontalAlignment="Right" Width="20">
                                                            <!-- Рисуем стрелочку -->
                                                            <Path Data="M 0 0 L 4 4 L 8 0" 
                                                          Stroke="{TemplateBinding Foreground}" 
                                                          StrokeThickness="2" 
                                                          VerticalAlignment="Center" 
                                                          HorizontalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <!-- Отображение выбранного текста -->
                            <ContentPresenter IsHitTestVisible="False" 
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      VerticalAlignment="Center" 
                                      Margin="{TemplateBinding Padding}"/>

                            <!-- Выпадающий список -->
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" 
                                Background="#1c1c1c" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Background" Value="#1c1c1c"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#FF656667"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}"/>
            <Setter Property="RowBackground" Value="{StaticResource InputBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="#0c0c0c"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="BorderBrush" Value="#EAEAEA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">



        <!-- Основная область -->
        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <!-- Периоды -->
                <ColumnDefinition Width="260"/>

                <ColumnDefinition Width="8"/>

                <!-- Свойства периода -->
                <ColumnDefinition Width="290"/>

                <ColumnDefinition Width="8"/>

                <!-- Контент -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================= -->
            <!-- ПЕРИОДЫ ПОКАЗА -->
            <!-- ============================= -->

            <Border Grid.Column="0"
        Background="#FF282828"
        CornerRadius="14"
        Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                   Text="ПЕРИОД"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#EAEAEA"
                   HorizontalAlignment="Left"/>

                    <ListBox x:Name="DaysListBox"
                 Grid.Row="2"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionChanged="DaysListBox_SelectionChanged"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border x:Name="PeriodCard"
                            Background="#2B2B2B"
                            CornerRadius="10"
                            Height="54"
                            Padding="14,0">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid>

                                            <TextBlock x:Name="PeriodNameTextBlock"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           Foreground="#F0F0F0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MouseDown="PeriodNameTextBlock_MouseDown"/>

                                            <TextBox x:Name="PeriodNameEditTextBox"
                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="Collapsed"
                                         VerticalContentAlignment="Center"
                                         FontSize="14"
                                         Foreground="#F0F0F0"
                                         Background="#3A3A3A"
                                         BorderBrush="#5A5A5A"
                                         BorderThickness="1"
                                         Padding="6,0"
                                         KeyDown="PeriodNameEditTextBox_KeyDown"
                                         LostFocus="PeriodNameEditTextBox_LostFocus"/>

                                        </Grid>

                                        <Button x:Name="PeriodMenuButton"
                                    Grid.Column="1"
                                    Content="..."
                                    Visibility="Collapsed"
                                    Style="{StaticResource PeriodMenuDotsStyle}"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Click="PeriodMenuButton_Click">

                                            <Button.ContextMenu>
                                                <ContextMenu>

                                                    <MenuItem Header="Изменить"
                                                  Click="EditPeriod_Click"/>

                                                    <MenuItem Header="Удалить"
                                                  Click="DeletePeriod_Click"/>

                                                </ContextMenu>
                                            </Button.ContextMenu>

                                        </Button>

                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>

                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
                                     Value="True">

                                        <Setter TargetName="PeriodCard"
                                    Property="Background"
                                    Value="#444444"/>

                                        <Setter TargetName="PeriodMenuButton"
                                    Property="Visibility"
                                    Value="Visible"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                     Value="True">

                                        <Setter TargetName="PeriodCard"
                                    Property="Background"
                                    Value="#5A5A5A"/>

                                    </DataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>

                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                           Value="True"/>

                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
                                           Value="True"/>

                                        </MultiDataTrigger.Conditions>

                                        <Setter TargetName="PeriodCard"
                                    Property="Background"
                                    Value="#666666"/>

                                        <Setter TargetName="PeriodMenuButton"
                                    Property="Visibility"
                                    Value="Visible"/>

                                    </MultiDataTrigger>

                                </DataTemplate.Triggers>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <Button x:Name="AddDayGroupButton"
                Grid.Row="4"
                Content="+"
                Style="{StaticResource SecondaryButtonStyle}"
                Height="56"
                FontSize="28"
                FontWeight="Light"
                Margin="0"
                Click="AddDayGroupButton_Click"/>

                </Grid>
            </Border>


            <!-- ============================= -->
            <!-- СВОЙСТВА ПЕРИОДА -->
            <!-- ============================= -->

            <Border Grid.Column="2"
        Background="#FF282828"
        CornerRadius="14"
        Padding="18">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- Заголовок -->

                    <TextBlock Grid.Row="0"
                   Text="СВОЙСТВА"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#EAEAEA"
                   HorizontalAlignment="Left"/>


                    <!-- Основные свойства -->

                    <StackPanel Grid.Row="2">


                        <!-- Название -->

                        <TextBlock Text="НАЗВАНИЕ"
                                   HorizontalAlignment="Right"
                       Foreground="#AFAFAF"
                       FontSize="10"
                       Margin="0,0,0,6"/>

                        <TextBox x:Name="PeriodNameTextBox"
                     Style="{StaticResource InputTextBoxStyle}"
                     Margin="0,0,0,20"/>


                        <!-- Начало -->

                        <TextBlock Text="НАЧАЛО"
                                   HorizontalAlignment="Right"
                       Foreground="#AFAFAF"
                       FontSize="10"
                       Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>


                            <DatePicker x:Name="StartDatePicker"
                            Grid.Column="0"
                            SelectedDateFormat="Short"
                            FocusVisualStyle="{x:Null}"
                            Style="{StaticResource DarkDatePickerStyle}"/>


                            <TextBox x:Name="StartHourTextBox"
                         Grid.Column="2"
                         Text="00"
                         Style="{StaticResource SmallTimeTextBoxStyle}"
                         PreviewTextInput="TimeTextBox_PreviewTextInput"
                         TextChanged="TimeTextBox_TextChanged"
                         MouseWheel="Hour_MouseWheel"/>


                            <TextBox x:Name="StartMinuteTextBox"
                         Grid.Column="4"
                         Text="00"
                         Style="{StaticResource SmallTimeTextBoxStyle}"
                         PreviewTextInput="TimeTextBox_PreviewTextInput"
                         TextChanged="TimeTextBox_TextChanged"
                         MouseWheel="Minute_MouseWheel"/>

                        </Grid>


                        <!-- Окончание -->

                        <TextBlock Text="ОКОНЧАНИЕ"
                                   HorizontalAlignment="Right"
                       Foreground="#AFAFAF"
                       FontSize="10"
                       Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,24">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>


                            <DatePicker x:Name="EndDatePicker"
                            Grid.Column="0"
                            SelectedDateFormat="Short"
                            FocusVisualStyle="{x:Null}"
                            Style="{StaticResource DarkDatePickerStyle}"/>


                            <TextBox x:Name="EndHourTextBox"
                         Grid.Column="2"
                         Text="23"
                         Style="{StaticResource SmallTimeTextBoxStyle}"
                         PreviewTextInput="TimeTextBox_PreviewTextInput"
                         TextChanged="TimeTextBox_TextChanged"
                         MouseWheel="Hour_MouseWheel"/>


                            <TextBox x:Name="EndMinuteTextBox"
                         Grid.Column="4"
                         Text="59"
                         Style="{StaticResource SmallTimeTextBoxStyle}"
                         PreviewTextInput="TimeTextBox_PreviewTextInput"
                         TextChanged="TimeTextBox_TextChanged"
                         MouseWheel="Minute_MouseWheel"/>

                        </Grid>


                        <!-- Разделитель -->

                        <Border Height="1"
                    Background="#414141"
                    Margin="0,0,0,20"/>


                        <!-- Режим дней недели -->

                        <CheckBox x:Name="UseWeekDaysCheckBox"
                      Content="Включить показ в дни недели"
                      Foreground="#AFAFAF"
                      FontSize="10"
                      FontWeight="SemiBold"
                      Margin="0,0,0,16"/>


                        <!-- Дни недели -->

                        <Grid HorizontalAlignment="Center">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                                <ToggleButton x:Name="MondayToggleButton"
                      Content="ПН"
                      Style="{StaticResource WeekDayToggleButtonStyle}"/>

                                <ToggleButton x:Name="TuesdayToggleButton"
                      Content="ВТ"
                      Style="{StaticResource WeekDayToggleButtonStyle}"/>

                                <ToggleButton x:Name="WednesdayToggleButton"
                      Content="СР"
                      Style="{StaticResource WeekDayToggleButtonStyle}"/>

                                <ToggleButton x:Name="ThursdayToggleButton"
                      Content="ЧТ"
                      Style="{StaticResource WeekDayToggleButtonStyle}"/>

                            </StackPanel>

                            <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                                <ToggleButton x:Name="FridayToggleButton"
                      Content="ПТ"
                      Style="{StaticResource WeekDayToggleButtonStyle}"/>

                                <ToggleButton x:Name="SaturdayToggleButton"
                      Content="СБ"
                      Style="{StaticResource WeekDayToggleButtonStyle}"/>

                                <ToggleButton x:Name="SundayToggleButton"
                      Content="ВС"
                      Style="{StaticResource WeekDayToggleButtonStyle}"/>

                            </StackPanel>

                        </Grid>


                        <TextBlock Text="Если режим выключен, период работает непрерывно между датой начала и окончания."
                       TextWrapping="Wrap"
                       Foreground="#777777"
                       FontSize="11"
                       Margin="0,14,0,0"/>

                    </StackPanel>


                    <!-- Применить -->

                    <Button x:Name="ApplyPeriodSettingsButton"
                Grid.Row="4"
                Content="ПРИМЕНИТЬ"
                Style="{StaticResource ApplyPeriodButtonStyle}"
                Height="44"
                Margin="0"
                Click="ApplyPeriodSettingsButton_Click"/>

                </Grid>
            </Border>



            <!-- Контент периода -->
            <Border Grid.Column="4"
        Background="#FF282828"
        CornerRadius="14"
        Padding="16"
        Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Шапка -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="КОНТЕНТ"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#EAEAEA"
                       HorizontalAlignment="left"
                       VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                       x:Name="PlaylistHeaderTextBlock"
                       Text="ПЛЕЙЛИСТ: НОВЫЙ ПЛЕЙЛИСТ"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#EAEAEA"
                       VerticalAlignment="Center"
                       MaxWidth="260"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Right"
                       Margin="20,0,0,0"/>
                    </Grid>

                    <!-- Зона таблицы / дропа -->
                    <Border Grid.Row="2"
        Background="#151515"
        CornerRadius="10"
        Padding="10"
        AllowDrop="True"
        DragEnter="DropZone_DragEnter"
        DragOver="DropZone_DragOver"
        Drop="DropZone_Drop">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>



                            <!-- Таблица -->
                            <Grid Grid.Row="0">

                                <TextBlock x:Name="EmptyDropHintTextBlock"
                       Text="ПЕРЕТАЩИ СЮДА ФОТО"
                       Foreground="#6F6F6F"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>

                                <DataGrid x:Name="ImagesDataGrid"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  HeadersVisibility="Column"
                                                  SelectionUnit="FullRow"
                                                  RowHeight="40"
                                                  GridLinesVisibility="None"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  SelectionMode="Single"
                                                  RowStyle="{StaticResource PlaylistRowStyle}"
                                                  MouseMove="ImagesDataGrid_MouseMove"
                                                  DragOver="ImagesDataGrid_DragOver"
                                                  DragLeave="ImagesDataGrid_DragLeave"
                                                  Drop="ImagesDataGrid_Drop"
                                                  AllowDrop="True"
                                                  RowEditEnding="ImagesDataGrid_RowEditEnding"
                                                  BeginningEdit="ImagesDataGrid_BeginningEdit"
                                                  PreviewMouseLeftButtonDown="ImagesDataGrid_PreviewMouseLeftButtonDown"
                                                  SelectionChanged="ImagesDataGrid_SelectionChanged"
                                                  ColumnWidth="*"
                                                  HorizontalScrollBarVisibility="Disabled">
                                    <DataGrid.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#5A5A5A"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#5A5A5A"/>
                                    </DataGrid.Resources>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>

                                        <!-- Тип -->
                                        <DataGridTextColumn Header="ТИП"
                                                Binding="{Binding Type}"
                                                Width="70"
                                                IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#EAEAEA"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Имя файла -->
                                        <DataGridTextColumn Header="ИМЯ ФАЙЛА"
                                         Binding="{Binding FileName}"
                                         Width="*"
                                         MinWidth="180" 
                                         IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#EAEAEA"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    

                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Длительность -->
                                        <DataGridTemplateColumn Header="ДЛИТ. (СЕК)" 
                                                                Width="105">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0">                                 
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#EAEAEA"/>
                                                                <Setter Property="Text" Value="{Binding DurationSeconds}"/>

                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}"/>
                                                                            <Condition Binding="{Binding PlayFullVideo}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="#777777"/>
                                                                        <Setter Property="Text" Value="FULL"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>

                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding DurationSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     Background="#2B2B2B"
                     BorderBrush="#5A5A5A"
                     BorderThickness="1"
                     FontSize="14"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     CaretBrush="White"
                     PreviewTextInput="DurationEditingTextBox_PreviewTextInput">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Foreground" Value="#EAEAEA"/>
                                                                <Setter Property="IsEnabled" Value="True"/>

                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}"/>
                                                                            <Condition Binding="{Binding PlayFullVideo}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Foreground" Value="#777777"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Старт видео -->
                                        <DataGridTemplateColumn Header="START" Width="75">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Text="{Binding StartSeconds}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#EAEAEA"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}"/>
                                                                            <Condition Binding="{Binding PlayFullVideo}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="#777777"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>

                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding StartSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     Background="#2B2B2B"
                     BorderBrush="#5A5A5A"
                     BorderThickness="1"
                     FontSize="14"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     CaretBrush="White">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Foreground" Value="#EAEAEA"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}"/>
                                                                            <Condition Binding="{Binding PlayFullVideo}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Foreground" Value="#777777"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Конец видео -->
                                        <DataGridTemplateColumn Header="END" Width="75">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Text="{Binding EndSeconds}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#EAEAEA"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}"/>
                                                                            <Condition Binding="{Binding PlayFullVideo}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="#777777"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>

                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding EndSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     Background="#2B2B2B"
                     BorderBrush="#5A5A5A"
                     BorderThickness="1"
                     FontSize="14"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     CaretBrush="White">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Foreground" Value="#EAEAEA"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}"/>
                                                                            <Condition Binding="{Binding PlayFullVideo}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Foreground" Value="#777777"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Полное воспроизведение -->
                                        <DataGridCheckBoxColumn Header="FULL"
                                                                Binding="{Binding PlayFullVideo, Mode=TwoWay}"
                                                                Width="65">
                                            <DataGridCheckBoxColumn.ElementStyle>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridCheckBoxColumn.ElementStyle>

                                            <DataGridCheckBoxColumn.EditingElementStyle>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridCheckBoxColumn.EditingElementStyle>
                                        </DataGridCheckBoxColumn>

                                        <!-- Эффект -->
                                        <DataGridTemplateColumn Header="ЭФФЕКТ" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="28"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding TransitionEffect}"
                           Foreground="#EAEAEA"
                           FontSize="14"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                                                        <Border x:Name="ArrowHost"
                        Grid.Column="1"
                        Background="Transparent"
                        Visibility="Collapsed">
                                                            <TextBlock Text="▼"
                               Foreground="#A0A0A0"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>

                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsMouseOver}" Value="True">
                                                            <Setter TargetName="ArrowHost" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>

                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValue="{Binding TransitionEffect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Content"
                      Style="{StaticResource DarkEffectComboBoxStyle}">


                                                        <ComboBoxItem Content="Затухание"/>
                                                        <ComboBoxItem Content="Без перехода"/>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Удаление -->
                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button x:Name="DeleteImageRowButton"
                        Content="×"
                        Width="40"
                        Height="30"
                        FontSize="22"
                        FontWeight="Bold"
                        Style="{StaticResource DeleteRowButtonStyle}"
                        Click="DeleteImageRowButton_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- Красивый overlay при перетаскивании файлов -->
                                <Border x:Name="FileDropOverlay"
        Visibility="Collapsed"
        Background="#E6151515"
        BorderBrush="#8A8A8A"
        BorderThickness="2"
        CornerRadius="10"
        IsHitTestVisible="False"
        Panel.ZIndex="100">

                                    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">

                                        <Border Width="72"
                Height="72"
                CornerRadius="36"
                Background="#353535"
                BorderBrush="#707070"
                BorderThickness="1"
                HorizontalAlignment="Center"
                Margin="0,0,0,18">

                                            <TextBlock Text="+"
                       Foreground="#EAEAEA"
                       FontSize="46"
                       FontWeight="Light"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,-7,0,0"/>
                                        </Border>

                                        <TextBlock Text="ПОМЕСТИ МЕНЯ СЮДА"
                   Foreground="#F0F0F0"
                   FontSize="24"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="Фото и видео будут добавлены в текущий период"
                   Foreground="#909090"
                   FontSize="13"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"/>

                                    </StackPanel>
                                </Border>


                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Нижние кнопки -->
                    <UniformGrid Grid.Row="4"
             Rows="1"
             Columns="6">

                        <Button x:Name="AddImagesButton"
            Content="+ МЕДИА"
            Style="{StaticResource SecondaryButtonStyle}"
            Margin="0,0,6,0"
            Click="AddImagesButton_Click"/>

                        <Button Content="ПОСЛЕДНИЙ"
            Style="{StaticResource SecondaryButtonStyle}"
            Margin="0,0,6,0"
            Click="OpenLastPlaylistButton_Click"/>

                        <Button Content="ЗАГРУЗИТЬ"
            Style="{StaticResource SecondaryButtonStyle}"
            Margin="0,0,6,0"
            Click="LoadPlaylistButton_Click"/>

                        <Button Content="СОХРАНИТЬ"
            Style="{StaticResource SecondaryButtonStyle}"
            Margin="0,0,6,0"
            Click="SavePlaylistButton_Click"/>

                        <Button Content="НАСТРОЙКИ"
            Style="{StaticResource SecondaryButtonStyle}"
            Margin="0,0,6,0"
            Click="OpenSettingsButton_Click"/>

                        <Button Content="СЛАЙДЕР"
            Style="{StaticResource SecondaryButtonStyle}"
            Margin="0"
            Click="OpenSliderButton_Click"/>

                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Правая панель -->

        </Grid>
        <!-- Скрытые технические контролы, чтобы не ломать текущую логику -->
        <StackPanel Visibility="Collapsed">
            <TextBox x:Name="PlaylistNameTextBox" Text="Новый плейлист"  TextChanged="PlaylistNameTextBox_TextChanged" />
            <TextBox x:Name="PlaylistPathTextBox"/>
            <CheckBox x:Name="AutoSaveCheckBox"/>
            <TextBox x:Name="AutoSaveMinutesTextBox" Text="5"/>
            <TextBlock x:Name="StatusTextBlock" Text=""/>

            <TextBox x:Name="SelectedImagePathTextBox"/>
            <TextBox x:Name="DurationTextBox" Text="5"/>

            <ComboBox x:Name="TransitionEffectComboBox">
                <ComboBoxItem Content="Затухание"/>
                <ComboBoxItem Content="Перелистывание"/>
            </ComboBox>

            <TextBlock x:Name="CurrentDayInfoTextBlock" Text=""/>

        </StackPanel>
    </DockPanel>
</Window>