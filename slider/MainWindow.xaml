<Window x:Class="slider.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:slider"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="gray">
    <Grid>
        <Button Content="Открыть слайдер"
            Width="145"
            Height="35"
            HorizontalAlignment="Left"
            
            VerticalAlignment="Top"
            Click="OpenSlider_Click" Margin="10,10,10,10" Panel.ZIndex="0" BorderThickness="0,0,0,0" FontFamily="Calibri" FontSize="12" UseLayoutRounding="False">

        </Button>
    </Grid>
</Window>
