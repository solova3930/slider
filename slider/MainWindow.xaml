                Height="1"
                Background="#EAEAEA"
                Margin="0,0,0,2"/>

                            <!-- Таблица -->
                            <Grid Grid.Row="2">

                                <TextBlock x:Name="EmptyDropHintTextBlock"
                       Text="ПЕРЕТАЩИ СЮДА ФОТО"
                       Foreground="#6F6F6F"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>

                                <DataGrid x:Name="ImagesDataGrid"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  HeadersVisibility="Column"
                                                  SelectionUnit="FullRow"
                                                  RowHeight="40"
                                                  GridLinesVisibility="None"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  SelectionMode="Single"
                                                  RowStyle="{StaticResource PlaylistRowStyle}"
                                                  MouseMove="ImagesDataGrid_MouseMove"
                                                  DragOver="ImagesDataGrid_DragOver"
                                                  DragLeave="ImagesDataGrid_DragLeave"
                                                  Drop="ImagesDataGrid_Drop"
                                                  AllowDrop="True"
                                                  RowEditEnding="ImagesDataGrid_RowEditEnding"
                                                  BeginningEdit="ImagesDataGrid_BeginningEdit"
                                                  PreviewMouseLeftButtonDown="ImagesDataGrid_PreviewMouseLeftButtonDown"
                                                  SelectionChanged="ImagesDataGrid_SelectionChanged">
                                    <DataGrid.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#5A5A5A"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#5A5A5A"/>
                                    </DataGrid.Resources>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>

                                        <!-- Тип -->
                                        <DataGridTextColumn Header="ТИП"
                        Binding="{Binding Type}"
                        Width="90"
                        IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#EAEAEA"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="TextAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Имя файла -->
                                        <DataGridTextColumn Header="ИМЯ ФАЙЛА"
                        Binding="{Binding FileName}"
                        Width="*"
                        IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#EAEAEA"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    

                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Длительность -->
                                        <DataGridTemplateColumn Header="ДЛИТ. (СЕК)" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0">                                 
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#EAEAEA"/>
                                                                <Setter Property="Text" Value="{Binding DurationSeconds}"/>

                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}"/>
                                                                            <Condition Binding="{Binding PlayFullVideo}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="#777777"/>
                                                                        <Setter Property="Text" Value="FULL"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>

                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding DurationSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     Background="#2B2B2B"
                     BorderBrush="#5A5A5A"
                     BorderThickness="1"
                     FontSize="14"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     CaretBrush="White"
                     PreviewTextInput="DurationEditingTextBox_PreviewTextInput">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Foreground" Value="#EAEAEA"/>
                                                                <Setter Property="IsEnabled" Value="True"/>

                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}"/>
                                                                            <Condition Binding="{Binding PlayFullVideo}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Foreground" Value="#777777"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Старт видео -->
                                        <DataGridTemplateColumn Header="START" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Text="{Binding StartSeconds}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#EAEAEA"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}"/>
                                                                            <Condition Binding="{Binding PlayFullVideo}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="#777777"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>

                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding StartSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     Background="#2B2B2B"
                     BorderBrush="#5A5A5A"
                     BorderThickness="1"
                     FontSize="14"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     CaretBrush="White">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Foreground" Value="#EAEAEA"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}"/>
                                                                            <Condition Binding="{Binding PlayFullVideo}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Foreground" Value="#777777"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Конец видео -->
                                        <DataGridTemplateColumn Header="END" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Text="{Binding EndSeconds}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#EAEAEA"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}"/>
                                                                            <Condition Binding="{Binding PlayFullVideo}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="#777777"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>

                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding EndSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     Background="#2B2B2B"
                     BorderBrush="#5A5A5A"
                     BorderThickness="1"
                     FontSize="14"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     CaretBrush="White">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Foreground" Value="#EAEAEA"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}"/>
                                                                            <Condition Binding="{Binding PlayFullVideo}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Foreground" Value="#777777"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Полное воспроизведение -->
                                        <DataGridCheckBoxColumn Header="FULL"
                        Binding="{Binding PlayFullVideo, Mode=TwoWay}"
                        Width="70">
                                            <DataGridCheckBoxColumn.ElementStyle>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridCheckBoxColumn.ElementStyle>

                                            <DataGridCheckBoxColumn.EditingElementStyle>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridCheckBoxColumn.EditingElementStyle>
                                        </DataGridCheckBoxColumn>

                                        <!-- Эффект -->
                                        <DataGridTemplateColumn Header="ЭФФЕКТ" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="28"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding TransitionEffect}"
                           Foreground="#EAEAEA"
                           FontSize="14"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                                                        <Border x:Name="ArrowHost"
                        Grid.Column="1"
                        Background="Transparent"
                        Visibility="Collapsed">
                                                            <TextBlock Text="▼"
                               Foreground="#A0A0A0"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>

                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsMouseOver}" Value="True">
                                                            <Setter TargetName="ArrowHost" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>

                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValue="{Binding TransitionEffect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Content"
                      Style="{StaticResource DarkEffectComboBoxStyle}">


                                                        <ComboBoxItem Content="Затухание"/>
                                                        <ComboBoxItem Content="Без перехода"/>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Удаление -->
                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button x:Name="DeleteImageRowButton"
                        Content="×"
                        Width="40"
                        Height="30"
                        FontSize="22"
                        FontWeight="Bold"
                        Style="{StaticResource DeleteRowButtonStyle}"
                        Click="DeleteImageRowButton_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- Красивый overlay при перетаскивании файлов -->
                                <Border x:Name="FileDropOverlay"
        Visibility="Collapsed"
        Background="#E6151515"
        BorderBrush="#8A8A8A"
        BorderThickness="2"
        CornerRadius="10"
        IsHitTestVisible="False"
        Panel.ZIndex="100">

                                    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">

                                        <Border Width="72"
                Height="72"
                CornerRadius="36"
                Background="#353535"
                BorderBrush="#707070"
                BorderThickness="1"
                HorizontalAlignment="Center"
                Margin="0,0,0,18">

                                            <TextBlock Text="+"
                       Foreground="#EAEAEA"
                       FontSize="46"
                       FontWeight="Light"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,-7,0,0"/>
                                        </Border>

                                        <TextBlock Text="ПОМЕСТИ МЕНЯ СЮДА"
                   Foreground="#F0F0F0"
                   FontSize="24"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="Фото и видео будут добавлены в текущий период"
                   Foreground="#909090"
                   FontSize="13"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"/>

                                    </StackPanel>
                                </Border>


                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Нижние кнопки -->
                    <UniformGrid Grid.Row="4" Columns="6" Margin="0">
                        <Button x:Name="AddImagesButton"
                    Content="+ МЕДИА"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="AddImagesButton_Click" />
                        <Button x:Name="OpenLastPlaylistButton"
                    Content="ПОСЛЕДНИЙ"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="OpenLastPlaylistButton_Click"/>

                        <Button x:Name="LoadPlaylistButton"
                    Content="ЗАГРУЗИТЬ"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="LoadPlaylistButton_Click"/>

                        <Button x:Name="SavePlaylistButton"
                    Content="СОХРАНИТЬ"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="SavePlaylistButton_Click"/>

                        <Button x:Name="OpenSettingsButton"
                    Content="НАСТРОЙКИ"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="OpenSettingsButton_Click"/>

                        <Button x:Name="OpenSliderButton"
                    Content="СЛАЙДЕР"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OpenSliderButton_Click"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Правая панель -->

        </Grid>
        <!-- Скрытые технические контролы, чтобы не ломать текущую логику -->
        <StackPanel Visibility="Collapsed">
            <TextBox x:Name="PlaylistNameTextBox" Text="Новый плейлист"  TextChanged="PlaylistNameTextBox_TextChanged" />
            <TextBox x:Name="PlaylistPathTextBox"/>
            <CheckBox x:Name="AutoSaveCheckBox"/>
            <TextBox x:Name="AutoSaveMinutesTextBox" Text="5"/>
            <TextBlock x:Name="StatusTextBlock" Text=""/>

            <TextBox x:Name="SelectedImagePathTextBox"/>
            <TextBox x:Name="DurationTextBox" Text="5"/>

            <ComboBox x:Name="TransitionEffectComboBox">
                <ComboBoxItem Content="Затухание"/>
                <ComboBoxItem Content="Перелистывание"/>
            </ComboBox>

            <TextBlock x:Name="CurrentDayInfoTextBlock" Text=""/>

        </StackPanel>
    </DockPanel>
</Window>