<Window x:Class="slider.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Style="{StaticResource DarkWindowStyle}"
        Icon="/app.ico"
        Height="560"
        Width="900"
        MinHeight="560"
        MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource MainWindowBackgroundBrush}"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="CheckBox" BasedOn="{StaticResource SettingsCheckBoxStyle}"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                               Text="Общие настройки"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Имя плейлиста" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0"/>
                        <TextBox Grid.Column="2" x:Name="PlaylistNameTextBox" Style="{StaticResource SettingsInputTextBoxStyle}"/>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Путь файла" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0"/>
                        <TextBlock Grid.Column="2" x:Name="PlaylistPathDisplay"
                                   Foreground="{StaticResource TextBrush}" FontSize="13"
                                   Height="42" VerticalAlignment="Center" Padding="0,12,0,0"
                                   Focusable="False" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Grid>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" x:Name="AutoSaveCheckBox" Content="Включить автосохранение"/>
                        <TextBox Grid.Column="2" x:Name="AutoSaveMinutesTextBox" Style="{StaticResource SettingsInputTextBoxStyle}" ToolTip="Интервал автосохранения в минутах"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Поток / запись" Style="{StaticResource SectionTitleStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="StartPlaylistStreamButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="ЗАПУСТИТЬ СТРИМ"
                                Margin="0"
                                Click="StartPlaylistStreamButton_Click"/>
                        <Button Grid.Column="2" x:Name="StopPlaylistStreamButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="ОСТАНОВИТЬ СТРИМ"
                                Margin="0"
                                Click="StopPlaylistStreamButton_Click"/>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="URL потока" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Row="1" x:Name="OutputUrlTextBox" Style="{StaticResource SettingsInputTextBoxStyle}"/>
                    </Grid>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Кодек" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CodecComboBox" Style="{StaticResource SettingsComboBoxStyle}">
                                <ComboBoxItem Content="H264"/>
                                <ComboBoxItem Content="HEVC"/>
                                <ComboBoxItem Content="MPEG2"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Пресет" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="PresetComboBox" Style="{StaticResource SettingsComboBoxStyle}">
                                <ComboBoxItem Content="ultrafast"/>
                                <ComboBoxItem Content="superfast"/>
                                <ComboBoxItem Content="veryfast"/>
                                <ComboBoxItem Content="faster"/>
                                <ComboBoxItem Content="fast"/>
                                <ComboBoxItem Content="medium"/>
                                <ComboBoxItem Content="slow"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="7" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Битрейт (kbps)" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="BitrateTextBox" Style="{StaticResource SettingsInputTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="FPS" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="FpsTextBox" Style="{StaticResource SettingsInputTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="9" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ширина" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="WidthTextBox" Style="{StaticResource SettingsInputTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Высота" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="HeightTextBox" Style="{StaticResource SettingsInputTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Отмена"
                    Style="{StaticResource SettingsActionButtonStyle}"
                    Click="CancelButton_Click"/>
            <Button Content="Сохранить"
                    Style="{StaticResource SettingsActionButtonStyle}"
                    Margin="0"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
