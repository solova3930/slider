<Window x:Class="slider.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Icon="/app.ico"
        Height="720"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#2F2F2F"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#5A5A5A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8"/>

            <Style.Triggers>
                <!-- hover -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>

                <!-- selected -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4B5563"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="BorderBrush" Value="#5A5A5A"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="2,0,0,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#374151"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4B5563"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#DADADA"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="BorderBrush" Value="#5A5A5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="BorderBrush" Value="#5A5A5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                                    <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False"
                                          Background="#2A2A2A"
                                          BorderBrush="#5A5A5A"
                                          BorderThickness="1,0,0,0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                    <TextBlock Text="▼"
                                                       Foreground="#F0F0F0"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                Background="#1F1F1F"
                                BorderBrush="#5A5A5A"
                                BorderThickness="1"
                                CornerRadius="6">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#6B7280"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#6B7280"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Background="#3A3A3A" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Общие настройки" Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="Имя плейлиста" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="PlaylistNameTextBox" Style="{StaticResource InputTextBoxStyle}"/>

                        <TextBlock Text="Путь файла плейлиста" Style="{StaticResource LabelStyle}" Margin="0,12,0,6"/>
                        <TextBox x:Name="PlaylistPathTextBox" Style="{StaticResource InputTextBoxStyle}" IsReadOnly="True"/>

                        <CheckBox x:Name="AutoSaveCheckBox"
                                  Content="Включить автосохранение"
                                  Foreground="#F0F0F0"
                                  FontSize="14"
                                  Margin="0,14,0,0"/>

                        <TextBlock Text="Интервал автосохранения (минуты)" Style="{StaticResource LabelStyle}" Margin="0,12,0,6"/>
                        <TextBox x:Name="AutoSaveMinutesTextBox" Style="{StaticResource InputTextBoxStyle}"/>
                    </StackPanel>
                </Border>

                <Border Background="#3A3A3A" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Поток / запись" Style="{StaticResource SectionTitleStyle}"/>
                        <CheckBox x:Name="EnableStreamingCheckBox"
          Content="Включить стриминг"
          Foreground="#F0F0F0"
          FontSize="14"
          Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="StartPlaylistStreamButton"
        Style="{StaticResource SecondaryButtonStyle}"
        Content="СТРИМ ПЛЕЙЛИСТ"
        Width="130"
        Margin="0,0,8,0"
        Click="StartPlaylistStreamButton_Click"/>

                            <Button x:Name="StopPlaylistStreamButton"
        Style="{StaticResource SecondaryButtonStyle}"
        Content="СТОП СТРИМ"
        Width="110"
        Margin="8,0,0,0"
        Click="StopPlaylistStreamButton_Click"/>
                        </StackPanel>
                        <TextBlock Text="URL потока" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="OutputUrlTextBox" Style="{StaticResource InputTextBoxStyle}"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Кодек" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="CodecComboBox" Style="{StaticResource InputComboBoxStyle}">
                                    <ComboBoxItem Content="H264"/>
                                    <ComboBoxItem Content="HEVC"/>
                                    <ComboBoxItem Content="MPEG2"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Пресет" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="PresetComboBox" Style="{StaticResource InputComboBoxStyle}">
                                    <ComboBoxItem Content="ultrafast"/>
                                    <ComboBoxItem Content="superfast"/>
                                    <ComboBoxItem Content="veryfast"/>
                                    <ComboBoxItem Content="faster"/>
                                    <ComboBoxItem Content="fast"/>
                                    <ComboBoxItem Content="medium"/>
                                    <ComboBoxItem Content="slow"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Битрейт (kbps)" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="BitrateTextBox" Style="{StaticResource InputTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="FPS" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="FpsTextBox" Style="{StaticResource InputTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Ширина" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="WidthTextBox" Style="{StaticResource InputTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Высота" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="HeightTextBox" Style="{StaticResource InputTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <CheckBox x:Name="LoopPlaylistCheckBox"
                                          Content="Зациклить воспроизведение"
                                          Foreground="#F0F0F0"
                                          FontSize="14"
                                          Margin="0,28,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">

            <Button Content="Отмена"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click"/>

            <Button Content="Сохранить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
